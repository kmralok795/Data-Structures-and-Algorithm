import java.util.HashMap;
class Main{
    public static int singleNumberBrute(int[] nums){
        for(int i=0; i<nums.length; i++){
            int count=0;
            for(int j=0; j<nums.length; j++){
                if(nums[i]==nums[j]){
                    count++;
                }
            }
            if(count==1){
                return nums[i];
            }
        }return -1;
    }
    
    
    public static int singleNumberBetter(int[] nums){
        HashMap<Integer, Integer> map=new HashMap<>();
        for(int num:nums){
            map.put(num,map.getOrDefault(num, 0)+1);
        }
        
        for(int num:nums){
            if(map.get(num)==1){
                return num;
            }
        }return -1;
    }
    
    
    public static int singleNumberOptimal(int[] nums){
        int ans=0;
        for(int num: nums){
            ans^=num;
        }return ans;
    }
    public static void main(String ar[]){
        int[] nums={2,1,2};
        int[] nums1={4,1,2,1,2};
        int[] nums2={2,2,3,3};
        System.out.println("Single Number: "+singleNumberBrute(nums));
        System.out.println("Single Number: "+singleNumberBetter(nums));
        System.out.println("Single Number: "+singleNumberOptimal(nums));
        System.out.println("Single Number: "+singleNumberBrute(nums1));
        System.out.println("Single Number: "+singleNumberBetter(nums1));
        System.out.println("Single Number: "+singleNumberOptimal(nums1));
        System.out.println("Single Number: "+singleNumberBrute(nums2));
        System.out.println("Single Number: "+singleNumberBetter(nums2));
        System.out.println("Single Number: "+singleNumberOptimal(nums2));
    }
}
